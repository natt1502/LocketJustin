name=Locket Gold - Justin Do
#!desc=Module cấu hình Locket Widget - Justindo
# 💻 Tiktok: https://www.tiktok.com/@iamcphuc_?_r=1&_t=ZS-9BOvc44iJts
# 🚀 Rewrite by: Justin Do

[General]
user-agent = Locket/1.0.0 (iPhone; iOS 26.3; Scale/3.00)

[Script]
# ~ Locket Gold - Shadowrocket / Surge / LanceX

# RevenueCat Response
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/natt1502/LocketJustin/refs/heads/main/revenuecatrp.js, requires-body=true, max-size=-1, timeout=60

# RevenueCat Request Header
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/natt1502/LocketJustin/refs/heads/main/revenuecatrq.js, timeout=60

# Locket Firebase Remote Config
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/natt1502/LocketJustin/refs/heads/main/locketrcjustin.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND%, api.revenuecat.com, firebaseremoteconfig.googleapis.com